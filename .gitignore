# Large regenerable pipeline intermediates: redundant copies of the same PC
# matrix (one per merge threshold) plus the posterior arrays. They are reproduced
# exactly by re-running the notebook and their checksums live in
# tools/baseline_manifest.json, so `verify_results --manifest` still validates a
# run without them in version control.
# Everything else under results/ stays tracked: the keep_lists/ deliverables, the
# summary and evidence tables, the audit logs and the figures.
results/01_reference_model/denoising/reference_samples_denoised.tsv
results/01_reference_model/mixture_model/reference_samples_clustered.tsv
results/01_reference_model/component_merging/**/reference_samples_merged.tsv
results/01_reference_model/component_merging/**/merged_posterior_probabilities.npy
results/01_reference_model/component_merging/reference_samples_merged.tsv
results/01_reference_model/component_merging/merged_posterior_probabilities.npy

# Verification scratch trees and the artifact cache
results_verify/
results_verify2/
results_baseline/
results_probe/
results_fig/
.cache/

# Individual-level data — never publish.
#
# These tables carry FID, IID and per-sample PC coordinates (PC1_AVG, PC2_AVG)
# alongside the posterior over every component. PC scores are a low-dimensional
# genotype summary, so a row identifies a person's genetic position, not an
# aggregate. They are regenerated by any run and their checksums live in
# tools/baseline_manifest.json, so verification still works without them.
results/**/cohort_posterior_probabilities.tsv
results/**/subcluster_posterior_probabilities.tsv
# Historical names for the same tables, kept so an old branch cannot reintroduce them.
results/**/our_posterior_probabilities_*.tsv
